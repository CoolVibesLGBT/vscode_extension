{
  "name": "coolvibes-vscode-extension",
  "publisher": "CoolVibes",
  "displayName": "CoolVibes",
  "description": "CoolVibes LGBTQIA+ community and dating in VS Code: feeds, profiles, friends, discovery, private and group chats, and 23 locale variants.",
  "version": "0.0.9",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/CoolVibesLGBT/vscode_extension.git"
  },
  "homepage": "https://github.com/CoolVibesLGBT/vscode_extension",
  "bugs": {
    "url": "https://github.com/CoolVibesLGBT/vscode_extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "coolvibes",
    "lgbtqia",
    "community",
    "social",
    "chat",
    "dating",
    "messaging",
    "profiles",
    "groups"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "icon": "media/brand/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onView:coolvibes.sidebar",
    "onCommand:coolvibes.openPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "coolvibes.openPanel",
        "title": "CoolVibes: Open Panel",
        "category": "CoolVibes"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coolvibes",
          "title": "CoolVibes",
          "icon": "media/brand/icon.png"
        }
      ]
    },
    "views": {
      "coolvibes": [
        {
          "type": "webview",
          "id": "coolvibes.sidebar",
          "name": "CoolVibes"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check ./extension.js",
    "build": "node ./scripts/build-webview.mjs",
    "build:webview": "node ./scripts/build-webview.mjs",
    "vscode:prepublish": "yarn run check && yarn run build",
    "package:vsix": "vsce package",
    "publish:marketplace": "vsce publish",
    "check:assets": "node scripts/checks/asset-paths.cjs",
    "check:assets:browser": "node scripts/checks/webview-assets.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  },
  "files": [
    "extension.js",
    "media/**/*",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ]
}
